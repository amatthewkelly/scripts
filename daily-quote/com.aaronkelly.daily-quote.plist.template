<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.aaronkelly.daily-quote</string>
	<key>ProgramArguments</key>
	<array>
		<string>{{HOME}}/.local/bin/daily-quote</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>8</integer>
		<key>Minute</key>
		<integer>30</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>{{HOME}}/Library/Logs/daily-quote.log</string>
	<key>StandardErrorPath</key>
	<string>{{HOME}}/Library/Logs/daily-quote.error.log</string>
</dict>
</plist>
